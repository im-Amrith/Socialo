# Socialo Environment Variables Example

# ==========================================
# Backend Configuration (.env in /backend)
# ==========================================

# PostgreSQL Connection String (Supabase or other Postgres provider)
# Uses the asyncpg driver (postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# Supabase Authentication Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Gmail SMTP Configuration for Email Notifications
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password

# Google Drive API Service Account (Required for photo uploads)
# Ensure the `client_secret_*.json` is in the backend root directory.

# ==========================================
# Frontend Configuration (.env in /frontend)
# ==========================================

# Supabase URL and Anon Key for Client-Side Auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL
VITE_API_BASE_URL=http://localhost:8000
